generator client {
  provider = "prisma-client-js"
  output   = "../src/prisma-client/"
}

datasource db {
  provider = "postgresql"
}

enum RecordSetsType {
  WEIGHT
  BODYWEIGHT_MINUS_OFFSET
  TIME
  WEIGHT_AND_TIME
  BODYWEIGHT_PLUS_WEIGHT
  REPS
}

enum SetType {
  WARMUP
  STANDARD
  FAILURE
}

enum BodyAreaLabel {
  CHEST
  BACK
  SHOULDERS
  ARMS
  CORE
  LEGS
}

enum MuscleGroupLabel {
  PECTORALIS_MAJOR
  PECTORALIS_MINOR
  LATISSIMUS_DORSI
  TRAPEZIUS
  RHOMBOIDS
  LOWER_BACK
  REAR_DELTOIDS
  FRONT_DELTOIDS
  BICEPS
  TRICEPS
  FOREARMS
  ABDOMINALS
  OBLIQUES
  GLUTES
  HAMSTRINGS
  QUADRICEPS
  ADDUCTORS
  CALVES
}

model BodyArea {
  id           Int           @id @default(autoincrement())
  label        BodyAreaLabel @unique
  muscleGroups MuscleGroup[]

  @@map("body_areas")
}

model MuscleGroup {
  id         Int              @id @default(autoincrement())
  label      MuscleGroupLabel @unique
  bodyAreaId Int              @map("body_area_id")
  bodyArea   BodyArea         @relation(fields: [bodyAreaId], references: [id])

  primaryExercises   ExercisePrimaryMuscleGroup[]
  secondaryExercises ExerciseSecondaryMuscleGroup[]

  @@map("muscle_groups")
}

model Exercise {
  id             Int            @id @default(autoincrement())
  label          String         @unique
  recordSetsType RecordSetsType @map("record_sets_type")
  createdAt      DateTime       @default(now()) @map("created_at")

  primaryMuscleGroups   ExercisePrimaryMuscleGroup[]
  secondaryMuscleGroups ExerciseSecondaryMuscleGroup[]
  routineExercises      RoutineExercise[]
  workoutExercises      WorkoutExercise[]

  @@map("exercises")
}

model Routine {
  id     Int     @id @default(autoincrement())
  label  String?
  userId Int?    @map("user_id")
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  routineExercises RoutineExercise[]

  @@unique([label, userId])
  @@map("routines")
}

model RoutineExercise {
  routineId  Int      @map("routine_id")
  exerciseId Int      @map("exercise_id")
  position   Int
  routine    Routine  @relation(fields: [routineId], references: [id], onDelete: Cascade)
  exercise   Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@id([routineId, exerciseId])
  @@unique([routineId, position])
  @@map("routine_exercises")
}

model ExercisePrimaryMuscleGroup {
  exerciseId    Int         @map("exercise_id")
  muscleGroupId Int         @map("muscle_group_id")
  exercise      Exercise    @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  muscleGroup   MuscleGroup @relation(fields: [muscleGroupId], references: [id], onDelete: Cascade)

  @@id([exerciseId, muscleGroupId])
  @@map("exercise_primary_muscle_groups")
}

model ExerciseSecondaryMuscleGroup {
  exerciseId    Int         @map("exercise_id")
  muscleGroupId Int         @map("muscle_group_id")
  exercise      Exercise    @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  muscleGroup   MuscleGroup @relation(fields: [muscleGroupId], references: [id], onDelete: Cascade)

  @@id([exerciseId, muscleGroupId])
  @@map("exercise_secondary_muscle_groups")
}

model User {
  id          Int      @id @default(autoincrement())
  googleId    String   @unique @map("google_id")
  email       String
  name        String?
  createdAt   DateTime @default(now()) @map("created_at")
  preferences Json?

  bodyWeights UserBodyWeight[]
  workouts    UserWorkout[]
  routines    Routine[]

  @@map("users")
}

model UserBodyWeight {
  id         Int      @id @default(autoincrement())
  userId     Int      @map("user_id")
  weightKg   Decimal  @map("weight_kg") @db.Decimal(5, 2)
  recordedAt DateTime @default(now()) @map("recorded_at")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_body_weights")
}

model UserWorkout {
  id              Int               @id @default(autoincrement())
  userId          Int               @map("user_id")
  routineId       Int               @map("routine_id")
  routineLabel    String            @map("routine_label")
  startedAt       DateTime          @map("started_at")
  finishedAt      DateTime          @map("finished_at")
  durationSeconds Int?              @map("duration_seconds")
  totalWeightKg   Int?              @map("total_weight_kg")
  totalReps       Int?              @map("total_reps")
  bodyWeightKg    Decimal           @map("body_weight_kg") @db.Decimal(5, 2)
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercises       WorkoutExercise[]

  @@map("user_workouts")
}

model WorkoutExercise {
  id         Int          @id @default(autoincrement())
  workoutId  Int          @map("workout_id")
  exerciseId Int          @map("exercise_id")
  position   Int
  workout    UserWorkout  @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  exercise   Exercise     @relation(fields: [exerciseId], references: [id])
  sets       WorkoutSet[]

  @@map("workout_exercises")
}

model WorkoutSet {
  id                Int             @id @default(autoincrement())
  workoutExerciseId Int             @map("workout_exercise_id")
  position          Int
  setType           SetType         @map("set_type")
  weightKg          Decimal?        @map("weight_kg") @db.Decimal(5, 2)
  reps              Int?
  timeSeconds       Int?            @map("time_seconds")
  workoutExercise   WorkoutExercise @relation(fields: [workoutExerciseId], references: [id], onDelete: Cascade)

  @@map("workout_sets")
}
