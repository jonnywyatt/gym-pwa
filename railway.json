{
  "$schema": "https://schema.railpack.com",
  "steps": {
    "install": {
      "commands": ["npm ci"]
    },
    "build": {
      "builder": "RAILPACK",
      "inputs": [{ "step": "install"}],
      "commands": ["npm run build:api"]
    }
  },
  "deploy": {
    "preDeployCommand": "npx prisma migrate deploy --schema=./api/prisma/schema.prisma --config=./api/prisma.config.ts && npm run seed -w api",
    "startCommand": "npm run start -w api",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
