    "@vue/test-utils": "^2.4.6",
    "jsdom": "^27.4.0",
    "type-fest": "^2.19.0",
    "typescript": "^5.7.3",
    "vite": "^6.0.11",
    "vitest": "^4.0.18",
    "vue-tsc": "^2.2.0"
